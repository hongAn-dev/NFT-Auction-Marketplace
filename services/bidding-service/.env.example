# ── App Configuration ─────────────────────────────────────
APP_ENV=development
APP_PORT=8080
GRPC_PORT=50051

# ── PostgreSQL Database Configuration ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=nft_user
DB_PASSWORD=secret_password
DB_NAME=nft_auction

# ── Redis Cache Configuration ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── MongoDB Metadata Configuration ─────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=nft_metadata

# ── RabbitMQ Broker Configuration ──────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── SePay Sandbox Configuration ────────────────────────────
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NO=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_TOKEN=
