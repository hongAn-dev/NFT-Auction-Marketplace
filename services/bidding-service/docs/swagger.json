                "description": "Cập nhật thông tin tiêu đề, mô tả, ảnh hoặc trạng thái của NFT theo ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NFTs"
                ],
                "summary": "Cập nhật thông tin NFT",
                "parameters": [
                    {
                        "type": "string",
