datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("user")
  balance   Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model FiatTransaction {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  amount          Float
  gatewayRefId    String   @unique @map("gateway_ref_id")
  status          String   // PENDING, SUCCESS, FAILED
  type            String   @default("DEPOSIT") // DEPOSIT or WITHDRAW
  bankAccountInfo String?  @map("bank_account_info")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("fiat_transactions")
}

model UserBankAccount {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  bankCode    String   @map("bank_code")
  bankName    String   @map("bank_name")
  accountNo   String   @map("account_no")
  accountName String   @map("account_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("user_bank_accounts")
}

