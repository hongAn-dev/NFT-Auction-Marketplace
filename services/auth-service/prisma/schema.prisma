datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("user")
  // VND, số nguyên (docs/23 §4). balance: khả dụng; held: đang giữ ký quỹ.
  balance   Decimal  @default(0) @db.Decimal(18, 0)
  held      Decimal  @default(0) @db.Decimal(18, 0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model FiatTransaction {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  amount          Float
  gatewayRefId    String   @unique @map("gateway_ref_id")
  status          String   // PENDING, SUCCESS, FAILED
  type            String   @default("DEPOSIT") // DEPOSIT or WITHDRAW
  bankAccountInfo String?  @map("bank_account_info")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("fiat_transactions")
}

model UserBankAccount {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  bankCode    String   @map("bank_code")
  bankName    String   @map("bank_name")
  accountNo   String   @map("account_no")
  accountName String   @map("account_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("user_bank_accounts")
}


// Khoản giữ ký quỹ của một lượt đặt giá (docs/23 §4). id = holdId = bidId, dùng
// làm khoá idempotency: gọi lại cùng thao tác trả kết quả cũ.
model EscrowHold {
  id             String   @id
  userId         String   @map("user_id")
  amount         Decimal  @db.Decimal(18, 0)
  status         String // HELD, RELEASED, REFUNDED, CAPTURED
  counterpartyId String?  @map("counterparty_id") // người bán nhận tiền khi CAPTURED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("escrow_holds")
}
